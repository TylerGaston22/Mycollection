// -------------------------------------------------------------------------
// Function: getMostPopularBook
// Purpose:  Call MostPopularBookInCarts stored procedure and return
//           full book detail for the ad. Returns empty array if no carts.
// Input:    $p_dbh - open PDO handle
// Return:   associative row array or empty array
// -------------------------------------------------------------------------
function getMostPopularBook($p_dbh)
{
    $vBook = array();

    try {
        $vStmt = $p_dbh->prepare(
            'CALL MostPopularBookInCarts(@bookID, @editionID)');
        $vStmt->execute();
        $vStmt->closeCursor();

        $vRow = $p_dbh->query(
            'SELECT @bookID AS BookID, @editionID AS EditionID')
            ->fetch(PDO::FETCH_ASSOC);

        if (!empty($vRow['BookID']) && !empty($vRow['EditionID'])) {
            $vStmt2 = $p_dbh->prepare(
                'CALL GetBookEditionDetailWithAuthors(:bookID, :editionID)');
            $vStmt2->bindValue(
                ':bookID',    (int)$vRow['BookID'],    PDO::PARAM_INT);
            $vStmt2->bindValue(
                ':editionID', (int)$vRow['EditionID'], PDO::PARAM_INT);
            $vStmt2->execute();
            $vBook = $vStmt2->fetch(PDO::FETCH_ASSOC);
            $vStmt2->closeCursor();

            if ($vBook === false) {
                $vBook = array();
            }
        }
    } catch (PDOException $e) {
        error_log('getMostPopularBook failed: ' . $e->getMessage());
    }

    return $vBook;
}

// -------------------------------------------------------------------------
// Function: getCartCount
// Purpose:  Total quantity of items in the user's cart, used by the nav
//           badge. Wraps the GetCartCount stored function.
// Input:    $p_dbh - open PDO handle
//           $p_uid - Customer.CustomerID
// Return:   int total quantity (0 on failure or empty cart)
// -------------------------------------------------------------------------
function getCartCount($p_dbh, $p_uid)
{
    $vCount = 0;

    try {
        $vStmt = $p_dbh->prepare('SELECT GetCartCount(:uid) AS Total');
        $vStmt->bindValue(':uid', (int)$p_uid, PDO::PARAM_INT);
        $vStmt->execute();
        $vRow = $vStmt->fetch(PDO::FETCH_ASSOC);
        $vStmt->closeCursor();

        if ($vRow && $vRow['Total'] !== null) {
            $vCount = (int)$vRow['Total'];
        }
    } catch (PDOException $e) {
        error_log('getCartCount failed: ' . $e->getMessage());
    }

    return $vCount;
}
