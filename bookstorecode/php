// -------------------------------------------------------------------------
// Function: getCartItems
// Purpose:  Return all items in the user's cart with book/edition detail.
//           Joins CartContains to BookEdition, Book, Edition, Publisher,
//           and WrittenBy/Person for authors.
// Input:    $p_dbh - open PDO handle
//           $p_uid - Customer.CustomerID from session
// Return:   array of rows (empty on failure)
// -------------------------------------------------------------------------
function getCartItems($p_dbh, $p_uid)
{
    $vRows = array();

    try {
        $vStmt = $p_dbh->prepare('CALL GetCartItems(:uid)');
        $vStmt->bindValue(':uid', (int)$p_uid, PDO::PARAM_INT);
        $vStmt->execute();
        $vRows = $vStmt->fetchAll(PDO::FETCH_ASSOC);
        $vStmt->closeCursor();
    } catch (PDOException $e) {
        error_log('getCartItems failed: ' . $e->getMessage());
    }

    return $vRows;
}

// -------------------------------------------------------------------------
// Function: getCartCost
// Purpose:  Call GetCartCost stored procedure to get the discounted total.
// Input:    $p_dbh - open PDO handle
//           $p_uid - Customer.CustomerID
// Return:   float total cost (0.0 on failure)
// -------------------------------------------------------------------------
function getCartCost($p_dbh, $p_uid)
{
    $vTotal = 0.0;

    try {
        $vStmt = $p_dbh->prepare(
            'CALL GetCartCost(:uid, @total)');
        $vStmt->bindValue(':uid', (int)$p_uid, PDO::PARAM_INT);
        $vStmt->execute();
        $vStmt->closeCursor();

        $vRow = $p_dbh->query('SELECT @total AS Total')
                      ->fetch(PDO::FETCH_ASSOC);
        if (isset($vRow['Total'])) {
            $vTotal = (float)$vRow['Total'];
        }
    } catch (PDOException $e) {
        error_log('getCartCost failed: ' . $e->getMessage());
    }

    return $vTotal;
}

// -------------------------------------------------------------------------
// Function: getCartDiscount
// Purpose:  Return the DiscountID currently applied to the user's cart,
//           or NULL if none. Used to keep an expired discount visible.
// Input:    $p_dbh - open PDO handle
//           $p_uid - Customer.CustomerID
// Return:   int DiscountID or null
// -------------------------------------------------------------------------
function getCartDiscount($p_dbh, $p_uid)
{
    $vDiscountID = null;

    try {
        $vStmt = $p_dbh->prepare(
            'SELECT GetCartDiscountID(:uid) AS DiscountID');
        $vStmt->bindValue(':uid', (int)$p_uid, PDO::PARAM_INT);
        $vStmt->execute();
        $vRow = $vStmt->fetch(PDO::FETCH_ASSOC);
        $vStmt->closeCursor();

        if ($vRow && $vRow['DiscountID'] !== null) {
            $vDiscountID = (int)$vRow['DiscountID'];
        }
    } catch (PDOException $e) {
        error_log('getCartDiscount failed: ' . $e->getMessage());
    }

    return $vDiscountID;
}

// -------------------------------------------------------------------------
// Function: getValidDiscounts
// Purpose:  Return discounts valid today (StartDate <= NOW <= EndDate).
//           If the cart already has an expired discount, include it too
//           so the user can keep using it per the A5 spec.
// Input:    $p_dbh           - open PDO handle
//           $p_currentDiscID - DiscountID currently on the cart (or null)
// Return:   array of rows with DiscountID, DiscountName, DollarAmount,
//           PercentageAmount
// -------------------------------------------------------------------------
function getValidDiscounts($p_dbh, $p_currentDiscID)
{
    $vRows = array();

    try {
        $vStmt = $p_dbh->prepare('CALL GetValidDiscounts(:currentID)');
        $vStmt->bindValue(
            ':currentID',
            ($p_currentDiscID !== null) ? (int)$p_currentDiscID : null,
            ($p_currentDiscID !== null) ? PDO::PARAM_INT : PDO::PARAM_NULL
        );
        $vStmt->execute();
        $vRows = $vStmt->fetchAll(PDO::FETCH_ASSOC);
        $vStmt->closeCursor();
    } catch (PDOException $e) {
        error_log('getValidDiscounts failed: ' . $e->getMessage());
    }

    return $vRows;
}

