# Copy this file to .env and fill in real values
# .env is gitignored — never commit it

# Supabase – get these from your Supabase project Settings > API
# URL: just the base, e.g. https://abc123.supabase.co (no /rest/v1)
# Key: use the "publishable" / anon key, NOT the secret/service_role key
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key-here

# TMDB – powers poster / year autofill in the Add Item dialog (src/tmdb/).
# Optional: the app runs without it, but TMDB autofill silently does nothing.
# Get one at themoviedb.org > Settings > API. Use the API Read Access Token
# (the long v4 "Bearer" token), NOT the short v3 API key.
VITE_TMDB_TOKEN=your-tmdb-read-access-token-here
